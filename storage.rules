rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && request.auth.token.email == "EMAIL_ADMIN@example.com"; }

    match /media/{uid}/{fileName} {
      allow read: if true;
      allow write: if signedIn() && (request.auth.uid == uid || isAdmin())
        && request.resource.size <= 100 * 1024 * 1024
        && request.resource.contentType.matches('(image/(jpeg|png|webp)|video/(mp4|webm|quicktime))');
      allow delete: if isAdmin();
    }
  }
}
